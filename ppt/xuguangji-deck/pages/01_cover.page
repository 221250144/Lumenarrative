pageType: cover
background:
  type: solid
  color: "$bg"
elements:
  - elementId: ring
    elementType: shape
    bounds: [600, -140, 480, 480]
    shapeName: donut
    adjustments: [3000]
    fill: {type: solid, color: "$gold"}
    opacity: 0.3
  - elementId: dot
    elementType: shape
    bounds: [836, 196, 8, 8]
    shapeName: ellipse
    fill: {type: solid, color: "$gold"}
  - elementId: kicker
    elementType: text
    bounds: [56, 60, 600, 16]
    content:
      style: "$kick"
      wrap: false
      text: INSTA360 THINK BOLD · 参赛作品
  - elementId: brand-icon
    elementType: image
    bounds: [56, 116, 60, 60]
    src: media/brand-icon.svg
    fit: {mode: contain}
  - elementId: wordmark
    elementType: text
    bounds: [132, 122, 300, 36]
    content:
      fontSize: 26
      color: "$ink"
      fontFamily: {latin: Liter, ea: 阿里妈妈数黑体}
      bold: true
      wrap: false
      text: 叙光集
  - elementId: wordmark-en
    elementType: text
    bounds: [134, 158, 300, 12]
    content:
      style: "$cap"
      wrap: false
      text: LUMENARRATIVE
  - elementId: title
    elementType: text
    bounds: [56, 236, 700, 150]
    content:
      style: "$h1"
      fontSize: 46
      text: |
        <p>以帧补光，</p>
        <p>以叙成章。</p>
  - elementId: subtitle
    elementType: text
    bounds: [56, 396, 700, 26]
    content:
      fontSize: 14
      color: "$sub"
      fontFamily: {latin: Liter, ea: MiSans}
      wrap: false
      text: 叙光集 Lumenarrative · Vlog 镜头诊断与补拍助手
  - elementId: desc
    elementType: text
    bounds: [56, 426, 700, 20]
    content:
      fontSize: 11
      color: "$mute"
      fontFamily: {latin: Liter, ea: MiSans}
      wrap: false
      text: 上传一条已经剪好的 Vlog，拆出镜头、逐镜理解，告诉你该补拍哪一镜。
  - elementId: rule
    elementType: line
    bounds: [56, 470, 848, 1]
    viewBox: [848, 1]
    points: "0,0.5 848,0.5"
    curve: sharp
    border: {style: solid, width: 1, color: "$line"}
  - elementId: timecode
    elementType: text
    bounds: [560, 484, 344, 14]
    content:
      style: "$cap"
      align: [right, top]
      wrap: false
      text: REEL 01 — 00:00:00 / 01:36
