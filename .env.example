# 本地：SQLite + 单进程后台队列；Compose 会覆盖数据库和队列配置。
DATABASE_URL=sqlite:///./data/xuguangji.db
# PostgreSQL 每个进程最多 4 个连接；SQLite 保留原连接池配置。
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2
DATA_DIR=./data
QUEUE_MODE=local
# 登录会话保留天数；当前 HTTP 部署为 false，切换 HTTPS 后设为 true。
AUTH_SESSION_DAYS=14
AUTH_COOKIE_SECURE=false
REDIS_URL=redis://localhost:6379/0
MODEL_PROVIDER=mock
# 百炼专属业务空间请改为控制台提供的完整 OpenAI-compatible 地址。
# 例如：https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=
VLM_MODEL=qwen3.8-max
LLM_MODEL=qwen-plus
# 单次模型响应等待秒数；0 表示不限制响应等待，连接/上传仍有独立超时。
MODEL_TIMEOUT_S=900
# 同一服务器所有 API/worker 共享最多 8 个模型请求。
MODEL_CONCURRENCY=8
# 8 核服务器：最多 2 条 FFmpeg 命令，每条编解码/滤镜线程上限 4。
MEDIA_CONCURRENCY=2
FFMPEG_THREADS=4
WORKER_CONCURRENCY=8
# HappyHorse 图生视频独立限流，不占 8 路视频理解槽位。
VIDEO_GENERATION_ENABLED=true
VIDEO_GENERATION_MODEL=happyhorse-1.1-i2v
# 留空时由 MODEL_BASE_URL 推导同一百炼业务空间的 /api/v1。
VIDEO_GENERATION_BASE_URL=
VIDEO_GENERATION_CONCURRENCY=1
VIDEO_GENERATION_POLL_S=15
VIDEO_GENERATION_TIMEOUT_S=900
# 可选：兼容 multipart /audio/transcriptions 的 ASR 服务。未配置时明确显示音频未分析。
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
MAX_UPLOAD_MB=256
MAX_ASSETS=20
MAX_PROJECT_DURATION_S=600
WINDOW_S=8
OVERLAP_S=2
SAMPLE_FPS=1
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
