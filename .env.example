# 本地：SQLite + 单进程后台队列；Compose 会覆盖数据库和队列配置。
DATABASE_URL=sqlite:///./data/xuguangji.db
DATA_DIR=./data
QUEUE_MODE=local
REDIS_URL=redis://localhost:6379/0
MODEL_PROVIDER=mock
# 百炼专属业务空间请改为控制台提供的完整 OpenAI-compatible 地址。
# 例如：https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=
VLM_MODEL=qwen3-vl-plus
LLM_MODEL=qwen-plus
MODEL_TIMEOUT_S=90
MODEL_CONCURRENCY=2
# 可选：兼容 multipart /audio/transcriptions 的 ASR 服务。未配置时明确显示音频未分析。
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
MAX_UPLOAD_MB=256
MAX_ASSETS=20
MAX_PROJECT_DURATION_S=600
WINDOW_S=8
OVERLAP_S=2
SAMPLE_FPS=1
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
