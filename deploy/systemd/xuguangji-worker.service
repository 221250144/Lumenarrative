[Unit]
Description=Xuguangji background worker
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
User=xuguangji
Group=xuguangji
WorkingDirectory=/opt/xuguangji/current
EnvironmentFile=/etc/xuguangji/app.env
Environment=PYTHONPATH=/opt/xuguangji/current/backend
Environment=PYTHONUNBUFFERED=1
Environment=WORKER_CONCURRENCY=8
ExecStart=/opt/xuguangji/venv/bin/celery -A app.workers.queue.celery_app worker --loglevel=INFO --concurrency=${WORKER_CONCURRENCY}
CPUQuota=800%
Restart=on-failure
RestartSec=5
TimeoutStopSec=600
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/xuguangji

[Install]
WantedBy=multi-user.target
